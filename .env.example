# LLM & Embedding API Configuration (any OpenAI-compatible endpoint)
LLM_MODEL=your-model-name
LLM_MODEL_SMALL=your-small-model-name
LLM_BASE_URL=https://your-llm-api/v1
LLM_API_KEY=your-api-key
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL — used by Docker Compose to configure the postgres service
# and by the app backends in POSTGRES_URI
POSTGRES_USER=genbi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=genbi

# MongoDB — used by Docker Compose to configure the mongodb service
MONGO_USER=genbi
MONGO_PASSWORD=change-me
