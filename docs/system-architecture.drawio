        <mxCell id="flow_ops" value="&lt;b&gt;Ops Feedback → RAG&lt;/b&gt;&lt;br&gt;User gives 👍/👎 on chat message → stored in MongoDB → Ops team reviews in Feedback page → promotes good NL→SQL pairs → POST /api/rag/fewshots writes embedding to pgvector → future RAG retrievals benefit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="788" width="420" height="54" as="geometry" />
