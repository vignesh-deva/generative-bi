        <mxCell id="flow_req" value="&lt;b&gt;Request Dashboard Flow&lt;/b&gt;&lt;br&gt;User clicks &quot;Request Dashboard&quot; on any AI message → captures question + answer + SQL + last 6 messages as context → POST /api/requests → MongoDB → Ops team reviews in Tickets page → 8-state lifecycle transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#388E3C;fontColor=#1B5E20;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="490" y="788" width="320" height="54" as="geometry" />
