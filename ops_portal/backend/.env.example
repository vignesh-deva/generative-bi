# Auth
PORTAL_USERNAME=testuser
PORTAL_PASSWORD=testpass
JWT_SECRET=change-me-in-prod

# LLM & Embedding (used by the feedback→RAG promotion flow)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
POSTGRES_URI=postgresql://<user>:<password>@localhost:5432/genbi

# MongoDB (authSource=admin required when using root credentials)
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/?authSource=admin
MONGODB_DB_NAME=genbi
