# LLM & Embedding API Configuration (any OpenAI-compatible endpoint)
LLM_MODEL=your-model-name
LLM_BASE_URL=https://your-llm-api/v1
LLM_API_KEY=your-api-key

# PostgreSQL
POSTGRES_URI=postgresql://<user>:<password>@localhost:5432/genbi

# MongoDB (authSource=admin required when using root credentials)
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/?authSource=admin
MONGODB_DB_NAME=genbi
